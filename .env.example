# PostBro runtime environment template — placeholders only, NO REAL SECRETS.
# Docs: docs/SETUP.md. Copy to local .env, secure permissions, and do not commit it.
# Values may be wired up incrementally as modules are implemented.

# Application / public callback
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Asia/Kuala_Lumpur
PUBLIC_BASE_URL=https://YOUR-STABLE-HOST.example.com

# Meta Threads app — Threads-specific credentials from Meta Developers.
THREADS_APP_ID=REPLACE_WITH_THREADS_APP_ID
THREADS_APP_SECRET=REPLACE_WITH_THREADS_APP_SECRET
THREADS_REDIRECT_URI=https://YOUR-STABLE-HOST.example.com/auth/threads/callback
# Enable only scopes granted for the app/test account. Discovery is gated separately.
THREADS_SCOPES=threads_basic,threads_content_publish,threads_read_replies,threads_manage_replies,threads_manage_insights

# Telegram @BotFather — user IDs, NOT @usernames.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_BOT_TOKEN
TELEGRAM_ALLOWED_USER_IDS=REPLACE_WITH_NUMERIC_TELEGRAM_USER_ID
# Development: polling. Production: webhook with stable HTTPS and secret validation.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_TELEGRAM_WEBHOOK_SECRET

# Supabase Cloud — new server-side secret API key, not legacy service_role JWT.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_sb_secret_KEY
SUPABASE_STORAGE_BUCKET=postbro-media
# Private DB URL needed for schema migration CLI / direct database operations.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# Optional: only for a future public client with properly configured RLS.
# SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_sb_publishable_KEY

# Backend token encryption / signed OAuth connection state.
# Generate separately using a secure CSPRNG; use 32 random bytes encoded base64.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
APP_SIGNING_SECRET=REPLACE_WITH_LONG_RANDOM_SIGNING_SECRET

# Hosted LLM / agent — provider-neutral adapter.
LLM_PROVIDER=REPLACE_WITH_PROVIDER
LLM_MODEL=REPLACE_WITH_MODEL_ID
LLM_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
# Optional: set only for a provider using a custom compatible endpoint.
# LLM_BASE_URL=https://YOUR_LLM_PROVIDER_ENDPOINT

# Durable execution defaults; enforce in server policy, NOT in model prompts.
PUBLISH_POLL_INTERVAL_SECONDS=30
REPLY_POLL_INTERVAL_SECONDS=120
DEFAULT_AUTOMATION_MODE=semi_auto
AUTO_ENGAGEMENT_ENABLED=false

# Optional future advanced access; never enable from a config flag alone.
# THREADS_ENABLE_KEYWORD_SEARCH=false
# THREADS_ENABLE_EXTERNAL_REPLIES=false
