{
  "name": "postbro-threads-engagement",
  "version": "0.1.0",
  "private": true,
  "description": "PostBro Threads automation backend scaffold",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "db:migrate": "npm run build && node dist/src/db/migrate-cli.js",
    "db:plan": "npm run build && node dist/src/db/migrate-cli.js --plan",
    "test:pg17": "npm run build && node --test dist/tests/db-postgres17-rehearsal.test.js"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true
  }
}
